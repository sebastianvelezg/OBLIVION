# Copia este archivo a ".env" (no lo subas a git). `docker compose` lo lee solo.

# ── Lo básico ────────────────────────────────────────────────────────────────

# Puerto del servidor donde se publica Oblivion (dentro del contenedor es siempre 3000).
OBLIVION_PORT=3000

# Código que se exige al crear la cuenta de administrador la primera vez.
# MUY recomendado: sin él, quien llegue primero a la web crea el administrador.
# Genera uno con:  openssl rand -hex 16
OBLIVION_SETUP_TOKEN=

# ── Detrás de un reverse proxy / acceso desde fuera ──────────────────────────

# Solo si hay un reverse proxy delante: confía en X-Forwarded-For/Proto/Host.
# OBLIVION_TRUST_PROXY=true

# Solo responde si el Host de la petición está en esta lista (separada por comas).
# OBLIVION_ALLOWED_HOSTS=oblivion.midominio.com

# Cookie «Secure»: auto (por defecto) | always | never
# OBLIVION_COOKIE_SECURE=auto

# ── Avanzado ─────────────────────────────────────────────────────────────────

# Clave maestra para cifrar las API keys de los widgets: 32 bytes en hex (64 caracteres).
# Si no la defines, se genera automáticamente en el volumen de datos (master.key).
# Genera una con:  openssl rand -hex 32
# OBLIVION_SECRET_KEY=

# ── Solo si NO usas Docker (ver docs/installation.md) ────────────────────────
# PORT=3000
# OBLIVION_DATA_DIR=./data
# OBLIVION_PLUGINS_DIR=./plugins
